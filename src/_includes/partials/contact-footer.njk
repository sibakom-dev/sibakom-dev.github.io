{% set lang = 'id' %}
{% if '/en/' in page.url %}{% set lang = 'en' %}{% endif %}
{% if '/fr/' in page.url %}{% set lang = 'fr' %}{% endif %}

{% set t = footer_id %}
{% if lang == 'en' %}{% set t = footer_en %}{% endif %}
{% if lang == 'fr' %}{% set t = footer_fr %}{% endif %}

<footer class="footer">
    <div class="container">
        <!-- Updated to a responsive 5-column grid layout -->
        <div class="footer-top"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--spacing-lg);">

            <!-- Column 1: Logo & Description -->
            <div>
                <a href="{{ '/' | locale_url }}" class="footer-logo" style="display: block; margin-bottom: var(--spacing-sm);">
                    <img src="/assets/images/Sibakom_Logo.png" alt="SIBAKOM Logo"
                        style="height: 40px; object-fit: contain;">
                </a>
                <p class="footer-desc"
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-sm);">
                    {{ t.subtitle }}
                </p>
                <p class="footer-desc"
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed);">
                    {{ t.description }}
                </p>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h4 class="footer-title">{{ t.quick_links_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-sm);">
                    <li><a href="{{ '/' | locale_url }}">{{ t.nav_home }}</a></li>
                    <li><a href="{{ '/about/' | locale_url }}">{{ t.nav_about }}</a></li>
                    <li><a href="{{ '/projects/' | locale_url }}">{{ t.nav_projects }}</a></li>
                    <li><a href="{{ '/contact/' | locale_url }}">{{ t.nav_contact }}</a></li>
                </ul>
            </div>

            <!-- Column 3: Key Solutions -->
            <div>
                <h4 class="footer-title">{{ t.services_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-sm);">
                    <li><a href="{{ '/services/weather-radar/' | locale_url }}">{{ t.service_radar }}</a></li>
                    <li><a href="{{ '/services/custom-nwp-models/' | locale_url }}">{{ t.service_nwp | safe }}</a></li>
                    <li><a href="{{ '/services/maritime-meteorology/' | locale_url }}">{{ t.service_maritime }}</a></li>
                    <li><a href="{{ '/services/agrometeorology/' | locale_url }}">{{ t.service_agro }}</a></li>
                    <li><a href="{{ '/services/lidar-monitoring/' | locale_url }}">{{ t.service_lidar }}</a></li>
                </ul>
            </div>

            <!-- Column 4: Reach Us -->
            <div>
                <h4 class="footer-title">{{ t.reach_us_title }}</h4>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.main_office }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-md);">
                    Grand Puri Niaga Blok K6/3D<br>
                    Jl. Puri Kencana, Kembangan<br>
                    Jakarta 11610<br>
                    Tel: <a href="tel:+622158351660"
                        style="color: var(--color-border-hover); text-decoration: none;">+6221 58351660</a>
                </p>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.branch_office }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-md);">
                    Jl. Brigjen Katamso Belakang<br>
                    No. 46 - 48, Medan 20151<br>
                    Tel: <a href="tel:+62614515386"
                        style="color: var(--color-border-hover); text-decoration: none;">+6261 4515386</a>
                </p>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.open_hours_title }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: 0;">
                    {{ t.open_hours_value }}
                </p>
            </div>

            <!-- Column 5: Contact -->
            <div>
                <h4 class="footer-title">{{ t.contact_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-md);">
                    <li><a href="mailto:info@sibakom.com">info@sibakom.com</a></li>
                    <li><a href="tel:+622158351660">+62 21 5835 1660</a></li>
                    <li
                        style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed);">
                        Jakarta, Indonesia<br>
                        {{ t.corporate_hq | safe }}
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-copy">&copy; 2026 SIBAKOM. {{ t.rights_reserved }}</div>
            <div class="footer-bottom-links">
                <a href="{{ '/legal/privacy-policy/' | locale_url | default('/legal/privacy-policy/') }}">{{ t.privacy_policy }}</a>
                <a href="{{ '/legal/terms-of-service/' | locale_url | default('/legal/terms-of-service/') }}">{{ t.terms_of_service }}</a>
            </div>
        </div>
    </div>
</footer>
