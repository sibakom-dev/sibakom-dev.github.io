{% set lang = 'id' %}
{% if '/en/' in page.url %}{% set lang = 'en' %}{% endif %}
{% if '/fr/' in page.url %}{% set lang = 'fr' %}{% endif %}

{% set t = footer_id %}
{% if lang == 'en' %}{% set t = footer_en %}{% endif %}
{% if lang == 'fr' %}{% set t = footer_fr %}{% endif %}

<footer class="footer">
    <div class="container">
        <!-- Updated to a responsive 5-column grid layout -->
        <div class="footer-top"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--spacing-lg);">

            <!-- Column 1: Logo & Description -->
            <div>
                <a href="{{ '/' | locale_url }}" class="footer-logo" style="display: flex; justify-content: flex-start; align-items: center; margin-bottom: var(--spacing-sm);">
                    <img src="/assets/images/Sibakom_Logo.png" alt="SIBAKOM Logo"
                        style="height: 60px; object-fit: contain; filter: brightness(0) invert(1);">
                </a>
                <p class="footer-desc"
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-sm);">
                    {{ t.subtitle }}
                </p>
                <p class="footer-desc"
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed);">
                    {{ t.description }}
                </p>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h4 class="footer-title">{{ t.quick_links_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-sm);">
                    <li><a href="{{ '/' | locale_url }}">{{ t.nav_home }}</a></li>
                    <li><a href="{{ '/about/' | locale_url }}">{{ t.nav_about }}</a></li>
                    <li><a href="{{ '/projects/' | locale_url }}">{{ t.nav_projects }}</a></li>
                    <li><a href="{{ '/contact/' | locale_url }}">{{ t.nav_contact }}</a></li>
                </ul>
            </div>

            <!-- Column 3: Key Solutions -->
            <div>
                <h4 class="footer-title">{{ t.services_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-sm);">
                    {% set servicesUrl = '/services/' | locale_url %}
                    {% set servicePages = collections.all | getChildren(servicesUrl) %}
                    {% for sPage in servicePages %}
                    <li><a href="{{ sPage.url }}">{{ sPage.data.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <!-- Column 4: Reach Us -->
            <div>
                <h4 class="footer-title">{{ t.reach_us_title }}</h4>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.main_office }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-md);">
                    Grand Puri Niaga Blok K6/3D<br>
                    Jl. Puri Kencana, Kembangan<br>
                    Jakarta 11610<br>
                    Tel: <a href="tel:+622158351660"
                        style="color: var(--color-border-hover); text-decoration: none;">+6221 58351660</a>
                </p>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.branch_office }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--spacing-md);">
                    Jl. Brigjen Katamso Belakang<br>
                    No. 46 - 48, Medan 20151<br>
                    Tel: <a href="tel:+62614515386"
                        style="color: var(--color-border-hover); text-decoration: none;">+6261 4515386</a>
                </p>

                <div
                    style="font-size: var(--fs-xs); font-weight: var(--fw-bold); color: var(--color-secondary); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">
                    {{ t.open_hours_title }}</div>
                <p
                    style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: 0;">
                    {{ t.open_hours_value }}
                </p>
            </div>

            <!-- Column 5: Contact -->
            <div>
                <h4 class="footer-title">{{ t.contact_title }}</h4>
                <ul class="footer-links" style="gap: var(--spacing-md);">
                    <li><a href="mailto:info@sibakom.com">info@sibakom.com</a></li>
                    <li><a href="tel:+622158351660">+62 21 5835 1660</a></li>
                    <li
                        style="color: var(--color-border-hover); font-size: var(--fs-sm); line-height: var(--lh-relaxed);">
                        Jakarta, Indonesia<br>
                        {{ t.corporate_hq | safe }}
                    </li>
                </ul>

                <h4 class="footer-title" style="margin-top: var(--spacing-md);">Follow Us</h4>
                <ul class="footer-links" style="gap: var(--spacing-sm); display: flex; flex-direction: row;">
                    <li><a href="https://instagram.com/sibakom_official" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                    </a></li>
                    <li><a href="https://linkedin.com/company/pt-sibakom/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </a></li>
                    <li><a href="https://x.com/sibakom" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
                    </a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-copy">&copy; 2026 SIBAKOM. {{ t.rights_reserved }}</div>
            <div class="footer-bottom-links">
                <a href="{{ '/legal/privacy-policy/' | locale_url | default('/legal/privacy-policy/') }}">{{ t.privacy_policy }}</a>
                <a href="{{ '/legal/terms-of-service/' | locale_url | default('/legal/terms-of-service/') }}">{{ t.terms_of_service }}</a>
            </div>
        </div>
    </div>
</footer>
