{% set parts = page.url.split('/') %}
{% set rubric_url = '/' + parts[1] + '/' + parts[2] + '/' %}
{% set related_items = collections.all | getChildren(rubric_url) %}

{% set read_also_text = 'Read Also:' %}
{% if parts[1] == 'id' %}
    {% set read_also_text = 'Baca Juga:' %}
{% elif parts[1] == 'fr' %}
    {% set read_also_text = 'Lire Aussi :' %}
{% endif %}

{% if related_items and related_items.length > 1 %}
<div class="related-posts" style="max-width: 800px; margin-inline: auto; margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--color-border);">
    <h3 style="margin-bottom: var(--spacing-md); font-size: var(--fs-lg);">{{ read_also_text }}</h3>
    <style>
        .related-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--spacing-md);
        }
        @media (max-width: 768px) {
            .related-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 480px) {
            .related-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <div class="related-grid">
        {% set shown = 0 %}
        {% for item in related_items | reverse %}
            {% if item.url != page.url and shown < 4 %}
                {% set shown = shown + 1 %}
                <a href="{{ item.url }}" style="text-decoration: none; color: inherit; transition: transform 0.3s ease; display: block;" onmouseover="this.style.transform='translateY(-5px)'; this.style.color='var(--color-primary)'" onmouseout="this.style.transform='translateY(0)'; this.style.color='inherit'">
                    <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); overflow: hidden; margin-bottom: var(--spacing-xs); background: var(--color-bg-alt); display: flex; align-items: center; justify-content: center;">
                        {% if item.data.image %}
                            <img src="{{ item.data.image }}" alt="{{ item.data.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                        {% elif item.data.heroImage %}
                            <img src="{{ item.data.heroImage }}" alt="{{ item.data.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                        {% else %}
                            <span style="color: var(--color-text-muted); font-size: 12px;">No Image</span>
                        {% endif %}
                    </div>
                    <h4 style="font-size: var(--fs-sm); font-weight: 600; margin-bottom: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">{{ item.data.title }}</h4>
                </a>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endif %}

