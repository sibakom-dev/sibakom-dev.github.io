<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description | default('SIBAKOM - System Integrator for Environmental Solutions. Experts in weather technology, maritime meteorology, and environmental monitoring.') }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    <title>{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}</title>

    <link rel="icon" type="image/svg+xml" href="/assets/images/Sibakom_Favicon.ico">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
</head>
<body>
    {% include "partials/header.njk" %}
    
    {{ content | safe }}

    {% include "partials/contact-footer.njk" %}
    
    <!-- Scripts -->
    <script src="/assets/js/main.js"></script>
</body>
</html>
