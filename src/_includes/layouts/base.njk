<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="{{ description | default('SIBAKOM - System Integrator for Meteorological Solutions. Experts in weather technology, maritime meteorology, and environmental monitoring.') }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    
    <meta property="og:title" content="{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}">
    <meta property="og:description" content="{{ description | default('SIBAKOM - System Integrator for Meteorological Solutions.') }}">
    {% if image %}
    <meta property="og:image" content="https://www.sibakom.com{{ image | replace(' ', '%20') }}">
    {% elif heroImage %}
    <meta property="og:image" content="https://www.sibakom.com{{ heroImage | replace(' ', '%20') }}">
    {% else %}
    <meta property="og:image" content="https://www.sibakom.com/assets/images/Sibakom_Logo.png">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.sibakom.com{{ page.url }}">
    <meta property="og:site_name" content="SIBAKOM">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}">
    <meta name="twitter:description" content="{{ description | default('SIBAKOM - System Integrator for Meteorological Solutions.') }}">
    {% if image %}
    <meta name="twitter:image" content="https://www.sibakom.com{{ image | replace(' ', '%20') }}">
    {% elif heroImage %}
    <meta name="twitter:image" content="https://www.sibakom.com{{ heroImage | replace(' ', '%20') }}">
    {% else %}
    <meta name="twitter:image" content="https://www.sibakom.com/assets/images/Sibakom_Logo.png">
    {% endif %}

    <title>{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}</title>

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="icon" type="image/svg+xml" href="/assets/images/Sibakom_Favicon.ico">
    <link rel="stylesheet" href="/assets/css/main.css?v=1.2">
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}

    {% set current_font = theme.font_family | default('Plus Jakarta Sans') %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{ current_font | replace(' ', '+') }}:wght@400;500;600;700&display=swap" rel="stylesheet">


    <style>
      :root {
      --font-heading: '{{ current_font }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      --font-body: '{{ current_font }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      
      {% if theme.theme_preset == 'Corporate Blue' or theme.theme_preset == 'Default' %}
        --color-primary: #2b5fa7;
        --color-secondary: #5b9bff;
        --color-accent: #6db6ff;
        --color-bg: #f4f8fc;
        --color-surface: #ffffff;
        --color-text: #17304f;
        --color-text-muted: #4e6e96;
        --color-border: #e1ebf5;
        --color-border-hover: #c7dbf0;
      {% elif theme.theme_preset == 'Eco Green / Earth' %}
        --color-primary: #2d6a4f;
        --color-secondary: #52b788;
        --color-accent: #74c69d;
        --color-bg: #f5fcf8;
        --color-surface: #ffffff;
        --color-text: #081c15;
        --color-text-muted: #5b7c6c;
        --color-border: #d8f3e6;
        --color-border-hover: #b7e4c7;
      {% elif theme.theme_preset == 'Deep Sea / Navy' %}
        --color-primary: #3b82f6;
        --color-secondary: #38bdf8;
        --color-accent: #7dd3fc;
        --color-bg: #0f172a;
        --color-surface: #1e293b;
        --color-text: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-border: #334155;
        --color-border-hover: #475569;
      {% elif theme.theme_preset == 'Charcoal / Neon Accent' %}
        --color-primary: #8b5cf6;
        --color-secondary: #f43f5e;
        --color-accent: #fb7185;
        --color-bg: #121212;
        --color-surface: #18181b;
        --color-text: #f4f4f5;
        --color-text-muted: #a1a1aa;
        --color-border: #3f3f46;
        --color-border-hover: #52525b;
      {% endif %}
      {% if theme.theme_preset == 'Custom' %}
        {% if theme.primary_color %}--color-primary: {{ theme.primary_color }};{% endif %}
        {% if theme.secondary_color %}--color-secondary: {{ theme.secondary_color }};{% endif %}
        {% if theme.accent_color %}--color-accent: {{ theme.accent_color }};{% endif %}
        {% if theme.bg_color %}--color-bg: {{ theme.bg_color }};{% endif %}
        {% if theme.text_color %}--color-text: {{ theme.text_color }};{% endif %}
      {% endif %}
      {% if theme.header_bg %}--header-bg: {{ theme.header_bg }};{% endif %}
      {% if theme.header_bg_scrolled %}--header-bg-scrolled: {{ theme.header_bg_scrolled }};{% endif %}
      {% if theme.header_blur is defined and theme.header_blur !== null and theme.header_blur !== '' %}--header-blur: {{ theme.header_blur }}px;{% endif %}
      }
    </style>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="6b50f72a-c54e-4067-9048-053327530975"></script>
</head>
<body>
    {% if theme.maintenance_mode %}
        <style>
            .maintenance-container {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                text-align: center;
                padding: var(--spacing-lg);
                background-color: var(--color-bg);
            }
            .maintenance-icon {
                margin-bottom: var(--spacing-md);
                color: var(--color-primary);
                animation: pulse 2s infinite;
            }
            @keyframes pulse {
                0% { opacity: 1; transform: scale(1); }
                50% { opacity: 0.7; transform: scale(0.95); }
                100% { opacity: 1; transform: scale(1); }
            }
            .maintenance-title {
                font-size: var(--fs-3xl);
                color: var(--color-text);
                margin-bottom: var(--spacing-sm);
                font-family: var(--font-heading);
            }
            .maintenance-desc {
                font-size: var(--fs-lg);
                color: var(--color-text-muted);
                max-width: 600px;
                line-height: var(--lh-relaxed);
                font-family: var(--font-body);
            }
            .maintenance-logo {
                margin-bottom: var(--spacing-xl);
            }
            .maintenance-logo img {
                height: 60px;
                width: auto;
            }
        </style>
        <div class="maintenance-container">
            <div class="maintenance-logo">
                <img src="/assets/images/Sibakom_Logo.png" alt="SIBAKOM Logo">
            </div>
            <div class="maintenance-icon">
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <h1 class="maintenance-title">We'll be back soon!</h1>
            <p class="maintenance-desc">We're currently performing scheduled maintenance to improve our services. Our website will be back online shortly. Thank you for your patience.</p>
        </div>
    {% else %}
        {% include "partials/header.njk" %}
        {% include "partials/breadcrumb.njk" %}
        
        {{ content | safe }}

        {% include "partials/contact-footer.njk" %}
        
        <!-- Scripts -->
        <script src="/assets/js/main.js?v=1.3"></script>
    {% endif %}
</body>
</html>
