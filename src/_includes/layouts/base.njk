<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description | default('SIBAKOM - System Integrator for Environmental Solutions. Experts in weather technology, maritime meteorology, and environmental monitoring.') }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    
    <meta property="og:title" content="{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}">
    <meta property="og:description" content="{{ description | default('SIBAKOM - System Integrator for Environmental Solutions.') }}">
    {% if image %}
    <meta property="og:image" content="https://sibakom-dev.github.io{{ image }}">
    {% elif heroImage %}
    <meta property="og:image" content="https://sibakom-dev.github.io{{ heroImage }}">
    {% else %}
    <meta property="og:image" content="https://sibakom-dev.github.io/assets/images/sibakom-logo.png">
    {% endif %}
    <meta property="og:type" content="website">

    <title>{{ title | default('SIBAKOM | Environmental Solutions & Weather Technology') }}</title>

    <link rel="icon" type="image/svg+xml" href="/assets/images/Sibakom_Favicon.ico">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}

    {% set current_font = theme.font_family | default('Plus Jakarta Sans') %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{ current_font | replace(' ', '+') }}:wght@400;500;600;700&display=swap" rel="stylesheet">


    <style>
      :root {
      --font-heading: '{{ current_font }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      --font-body: '{{ current_font }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      
      {% if theme.theme_preset == 'Corporate Blue' or theme.theme_preset == 'Default' %}
        --color-primary: #2b5fa7;
        --color-secondary: #5b9bff;
        --color-accent: #6db6ff;
        --color-bg: #f4f8fc;
        --color-surface: #ffffff;
        --color-text: #17304f;
        --color-text-muted: #4e6e96;
        --color-border: #e1ebf5;
        --color-border-hover: #c7dbf0;
      {% elif theme.theme_preset == 'Eco Green / Earth' %}
        --color-primary: #2d6a4f;
        --color-secondary: #52b788;
        --color-accent: #74c69d;
        --color-bg: #f5fcf8;
        --color-surface: #ffffff;
        --color-text: #081c15;
        --color-text-muted: #5b7c6c;
        --color-border: #d8f3e6;
        --color-border-hover: #b7e4c7;
      {% elif theme.theme_preset == 'Deep Sea / Navy' %}
        --color-primary: #3b82f6;
        --color-secondary: #38bdf8;
        --color-accent: #7dd3fc;
        --color-bg: #0f172a;
        --color-surface: #1e293b;
        --color-text: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-border: #334155;
        --color-border-hover: #475569;
      {% elif theme.theme_preset == 'Charcoal / Neon Accent' %}
        --color-primary: #8b5cf6;
        --color-secondary: #f43f5e;
        --color-accent: #fb7185;
        --color-bg: #121212;
        --color-surface: #18181b;
        --color-text: #f4f4f5;
        --color-text-muted: #a1a1aa;
        --color-border: #3f3f46;
        --color-border-hover: #52525b;
      {% endif %}
      {% if theme.theme_preset == 'Custom' %}
        {% if theme.primary_color %}--color-primary: {{ theme.primary_color }};{% endif %}
        {% if theme.secondary_color %}--color-secondary: {{ theme.secondary_color }};{% endif %}
        {% if theme.accent_color %}--color-accent: {{ theme.accent_color }};{% endif %}
        {% if theme.bg_color %}--color-bg: {{ theme.bg_color }};{% endif %}
        {% if theme.text_color %}--color-text: {{ theme.text_color }};{% endif %}
      {% endif %}
      {% if theme.header_bg %}--header-bg: {{ theme.header_bg }};{% endif %}
      {% if theme.header_bg_scrolled %}--header-bg-scrolled: {{ theme.header_bg_scrolled }};{% endif %}
      {% if theme.header_blur is defined and theme.header_blur !== null and theme.header_blur !== '' %}--header-blur: {{ theme.header_blur }}px;{% endif %}
      }
    </style>
</head>
<body>
    {% include "partials/header.njk" %}
    
    {{ content | safe }}

    {% include "partials/contact-footer.njk" %}
    
    <!-- Scripts -->
    <script src="/assets/js/main.js"></script>
</body>
</html>
