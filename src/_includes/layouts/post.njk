---
layout: layouts/base.njk
---
        {% set share_btn = "Share" %}
        {% set share_title = "Share Content" %}
        {% set copy_text = "Copy Link" %}
        {% set related_posts = null %}
        {% set read_also_text = "Read Also:" %}
        {% if tags %}
            {% if "newsroom_id" in tags %}
                {% set share_btn = "Bagikan" %}
                {% set share_title = "Bagikan Konten" %}
                {% set copy_text = "Salin Link" %}
                {% set related_posts = collections.newsroom_id %}
                {% set read_also_text = "Baca Juga:" %}
            {% elif "newsroom_fr" in tags %}
                {% set share_btn = "Partager" %}
                {% set share_title = "Partager le contenu" %}
                {% set copy_text = "Copier le lien" %}
                {% set related_posts = collections.newsroom_fr %}
                {% set read_also_text = "Lire Aussi :" %}
            {% elif "newsroom_en" in tags %}
                {% set related_posts = collections.newsroom_en %}
                {% set read_also_text = "Read Also:" %}
            {% endif %}
        {% endif %}

<section class="section" style="padding-top: 120px; min-height: 50vh;">
    <div class="container">
        <div class="post-header text-center" style="margin-bottom: var(--spacing-xl); max-width: 800px; margin-inline: auto;">
            {% if tags and tags.length > 0 %}
            <div class="post-tags" style="margin-bottom: var(--spacing-sm);">
                {% for tag in tags %}
                  {% if tag != "newsroom_en" and tag != "newsroom_id" and tag != "newsroom_fr" %}
                    <span class="project-tag">{{ tag }}</span>
                  {% endif %}
                {% endfor %}
            </div>
            {% endif %}
            
            <h1 class="section-title" style="margin-bottom: var(--spacing-sm);">{{ title }}</h1>
            
            <div class="post-meta" style="color: var(--color-text-muted); font-size: var(--fs-sm); display: flex; gap: var(--spacing-md); justify-content: center; align-items: center; margin-bottom: var(--spacing-lg); flex-wrap: wrap;">
                {% if writer %}<span>By <strong>{{ writer }}</strong></span>{% endif %}
                {% if date %}<span>{{ date | date_format }}</span>{% endif %}
                {% if read_time %}<span>{{ read_time }}</span>{% endif %}
                <button onclick="openShareModal()" class="share-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                    {{ share_btn }}
                </button>
            </div>
        </div>

        {% if image %}
        <div style="margin-bottom: var(--spacing-xl); text-align: center;">
            <img src="{{ image }}" alt="{{ title }}" style="width: 100%; max-height: 500px; object-fit: cover; border-radius: var(--radius-lg);">
        </div>
        {% endif %}

        <div class="page-content" style="font-size: var(--fs-md); line-height: var(--lh-relaxed); color: var(--color-text); max-width: 800px; margin-inline: auto; text-align: justify;">
            {{ content | safe }}
        </div>


        {% if related_posts %}
        <div class="related-posts" style="max-width: 800px; margin-inline: auto; margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <h3 style="margin-bottom: var(--spacing-md); font-size: var(--fs-lg);">{{ read_also_text }}</h3>
            <style>
                .related-grid {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: var(--spacing-md);
                }
                @media (max-width: 768px) {
                    .related-grid {
                        grid-template-columns: repeat(2, 1fr);
                    }
                }
                @media (max-width: 480px) {
                    .related-grid {
                        grid-template-columns: 1fr;
                    }
                }
            </style>
            <div class="related-grid">
                {% set shown = 0 %}
                {% for post in related_posts | reverse %}
                    {% if post.url != page.url and shown < 4 %}
                        {% set shown = shown + 1 %}
                        <a href="{{ post.url }}" style="text-decoration: none; color: inherit; transition: transform 0.3s ease; display: block;" onmouseover="this.style.transform='translateY(-5px)'; this.style.color='var(--color-primary)'" onmouseout="this.style.transform='translateY(0)'; this.style.color='inherit'">
                            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); overflow: hidden; margin-bottom: var(--spacing-xs); background: var(--color-bg-alt); display: flex; align-items: center; justify-content: center;">
                                {% if post.data.image %}
                                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                                {% else %}
                                    <span style="color: var(--color-text-muted); font-size: 12px;">No Image</span>
                                {% endif %}
                            </div>
                            <h4 style="font-size: var(--fs-sm); font-weight: 600; margin-bottom: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">{{ post.data.title }}</h4>
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Share Modal -->
    <div id="shareModal" class="share-modal-overlay">
        <div class="share-modal">
            <div class="share-modal-header">
                <h3>{{ share_title }}</h3>
                <button class="share-close-btn" onclick="closeShareModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="share-modal-body">
                <a href="https://api.whatsapp.com/send?text={{ title | urlencode }}%20https://www.sibakom.com{{ page.url }}" target="_blank" class="share-icon-btn whatsapp">
                    <div class="icon-circle"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></div>
                    <span>WhatsApp</span>
                </a>
                <a href="https://www.facebook.com/sharer/sharer.php?u=https://www.sibakom.com{{ page.url }}" target="_blank" class="share-icon-btn facebook">
                    <div class="icon-circle"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></div>
                    <span>Facebook</span>
                </a>
                <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url=https://www.sibakom.com{{ page.url }}" target="_blank" class="share-icon-btn twitter">
                    <div class="icon-circle"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></div>
                    <span>Twitter</span>
                </a>
                <button onclick="copyShareLink()" class="share-icon-btn copylink">
                    <div class="icon-circle"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></div>
                    <span>{{ copy_text }}</span>
                </button>
            </div>
            <div class="share-modal-footer">
                <input type="text" readonly value="https://www.sibakom.com{{ page.url }}" id="shareInputLink">
            </div>
        </div>
    </div>
</section>
