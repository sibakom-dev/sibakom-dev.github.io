---
layout: layouts/base.njk
---
<section class="section" style="padding-top: 120px; min-height: 50vh;">
    <div class="container">
        {% if heroImage %}
        <div style="margin-bottom: var(--spacing-lg);">
            <img src="{{ heroImage }}" alt="{{ title }}" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: var(--radius-lg);">
        </div>
        {% endif %}
        <div class="section-header text-center">
            {% if subtitle %}<span class="section-subtitle">{{ subtitle }}</span>{% endif %}
            <h1 class="section-title" style="margin-bottom: var(--spacing-md);">{{ title }}</h1>
        </div>
        <div class="page-content" style="font-size: var(--fs-md); line-height: var(--lh-relaxed); color: var(--color-text);">
            {{ content | safe }}

            {% if sections %}
              {% for section in sections %}
                <div class="zigzag-section container {% if section.reverse %}reverse{% elif loop.index0 % 2 != 0 %}reverse{% endif %}" style="margin-top: var(--spacing-xl);">
                  <div class="zigzag-text">
                    <h3>{{ section.title }}</h3>
                    {{ section.text | safe }}
                  </div>
                  <div class="zigzag-image">
                    <img src="{{ section.image }}" alt="{{ section.title }}">
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            {% if grid_cards %}
            <div class="grid grid-3 gap-md" style="margin-top: var(--spacing-xl);">
              {% for card in grid_cards %}
              {% if card.link %}
              <a href="{{ card.link }}" class="project-card" style="text-decoration: none; color: inherit;">
              {% else %}
              <div class="project-card">
              {% endif %}
                <div class="project-img-wrapper">
                  {% if card.tag %}<span class="project-tag">{{ card.tag }}</span>{% endif %}
                  <img src="{{ card.image }}" alt="{{ card.title }}" class="project-img">
                </div>
                <div class="project-content">
                  <h3 class="project-title">{{ card.title }}</h3>
                  <p class="project-desc">{{ card.description }}</p>
                  {% if card.link %}
                  <span class="project-link">
                    {{ card.link_text | default('Explore') }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </span>
                  {% endif %}
                </div>
              {% if card.link %}
              </a>
              {% else %}
              </div>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</section>
