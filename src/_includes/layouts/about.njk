---
layout: layouts/base.njk
---
{% if heroImage %}
<div class="hero-banner" style="width: 100%; height: 40vh; min-height: 300px; max-height: 500px; overflow: hidden; position: relative; margin-top: 80px;">
    <img src="{{ heroImage }}" alt="{{ title }}" style="width: 100%; height: 100%; object-fit: cover; display: block;">
</div>
{% endif %}

<section class="section" style="{% if not heroImage %}padding-top: 120px;{% else %}padding-top: var(--spacing-xl);{% endif %} min-height: 50vh;">
    <div class="container">
        <div class="section-header text-center" style="margin-bottom: 4rem;">
            {% if subtitle %}<span class="section-subtitle">{{ subtitle }}</span>{% endif %}
            <h1 class="section-title" style="margin-bottom: var(--spacing-md); font-size: 3rem;">{{ title }}</h1>
        </div>
        <div class="about-editorial">
            {{ content | safe }}
        </div>

        {% if page.fileSlug == 'about' or page.fileSlug == '' %}
        <div class="about-cta-section" style="margin-top: 6rem; padding-top: 4rem; border-top: 2px solid var(--color-border); max-width: 1000px; margin-inline: auto;">
            <h2 style="text-align: center; font-family: var(--font-heading); font-size: 2.5rem; color: var(--color-primary-dark); margin-bottom: 3rem;">Discover More</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                <!-- Specialization -->
                <a href="{{ '/about/specialization/' | locale_url }}" class="about-cta-card" style="display: flex; flex-direction: column; text-decoration: none; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); transition: transform 0.3s ease, box-shadow 0.3s ease; background: var(--color-surface);" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='var(--shadow-xl)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-md)';">
                    <div style="width: 100%; height: 250px; overflow: hidden;">
                        <img src="/assets/images/MAWS 1.png" alt="Specialization" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)'">
                    </div>
                    <div style="padding: 2rem; display: flex; flex-direction: column; flex-grow: 1;">
                        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-primary); margin-bottom: 1rem;">Specialization</h3>
                        <p style="color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">Explore our company field specification work, what we can do and what we will do.</p>
                        <span style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.875rem;">
                            See More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </span>
                    </div>
                </a>

                <!-- Strategic Partner -->
                <a href="{{ '/about/strategic-partners/' | locale_url }}" class="about-cta-card" style="display: flex; flex-direction: column; text-decoration: none; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); transition: transform 0.3s ease, box-shadow 0.3s ease; background: var(--color-surface);" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='var(--shadow-xl)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-md)';">
                    <div style="width: 100%; height: 250px; overflow: hidden;">
                        <img src="/assets/images/Sibakom_Hero_Banner.png" alt="Strategic Partner" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)'">
                    </div>
                    <div style="padding: 2rem; display: flex; flex-direction: column; flex-grow: 1;">
                        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-primary); margin-bottom: 1rem;">Strategic Partner</h3>
                        <p style="color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">Discover the world-class companies that we have deep partnership with for our environmental projects.</p>
                        <span style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.875rem;">
                            See More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </span>
                    </div>
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</section>
